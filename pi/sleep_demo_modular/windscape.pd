#N canvas 120 80 1180 760 10;
#X text 35 18 Windscape patch for sleep_demo_modular;
#X text 35 36 Receives UDP messages on port 9000: "bpm <n>\;" and "stage <name>\;";
#X obj 36 78 loadbang;
#X msg 36 110 \; pd dsp 1;
#X msg 152 110 bpm 60;
#X msg 232 110 stage Awake;
#X obj 36 160 netreceive -u 9000;
#X obj 36 190 list trim;
#X obj 36 220 route bpm stage;
#X obj 36 250 clip 30 180;
#X obj 36 280 t f f;
#X obj 36 310 s bpm-value;
#X obj 132 310 expr (($f1 - 30) / 150) * 0.25 + 0.04;
#X obj 132 340 s gust-rate;
#X obj 212 250 route Awake Light Deep REM awake light deep rem;
#X msg 212 282 1200;
#X msg 272 282 900;
#X msg 332 282 600;
#X msg 392 282 1500;
#X obj 212 314 s cutoff;
#X msg 212 366 0.12;
#X msg 272 366 0.10;
#X msg 332 366 0.07;
#X msg 392 366 0.14;
#X obj 212 398 s amp;
#X text 456 282 Cutoff by stage: Awake \/ Light \/ Deep \/ REM;
#X text 456 366 Amplitude by stage: Awake \/ Light \/ Deep \/ REM;
#X obj 700 110 r cutoff;
#X obj 700 140 pack f 500;
#X obj 700 170 line~;
#X obj 820 110 r amp;
#X obj 820 140 pack f 500;
#X obj 820 170 line~;
#X obj 940 110 r gust-rate;
#X obj 940 140 osc~ 0.08;
#X obj 940 170 *~ 0.2;
#X obj 940 200 +~ 0.8;
#X obj 700 240 noise~;
#X obj 700 270 hip~ 80;
#X obj 700 300 lop~ 900;
#X obj 700 330 *~;
#X obj 700 360 *~;
#X obj 700 390 rev3~ 100 85 3000 20;
#X obj 700 420 *~ 0.6;
#X obj 780 420 *~ 0.6;
#X obj 700 450 dac~;
#X text 700 485 Wind chain: noise -> filters -> gust LFO -> amp -> reverb -> stereo out;
