#X obj 700 240 noise~;
#X obj 700 270 hip~ 80;
#X obj 700 300 lop~ 900;
#X obj 700 330 *~;
#X obj 700 360 *~;
#X obj 700 390 rev3~ 100 85 3000 20;
#X obj 700 420 *~ 1.6;
#X obj 780 420 *~ 0;
#X obj 700 450 dac~;
#X text 700 485 Wind chain: noise -> filters -> gust LFO -> amp -> reverb -> stereo out;
#X obj 36 94 delay 500;
#X obj 1020 110 r bpm-value;
#X obj 1020 140 expr max($f1\, 30) / 60;
#X obj 1020 170 sig~;
